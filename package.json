{
  "name": "bloom-cafe-pos",
  "version": "1.3.0",
  "description": "Premium Point of Sale system for Bloom Cafe",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron-rebuild -f -w better-sqlite3 && electron .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/jest/bin/jest.js",
    "test:coverage": "jest --coverage",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish=never",
    "build:mac": "electron-builder --mac",
    "dist": "electron-builder --publish=never",
    "dist:win": "electron-builder --win --publish=never",
    "dist:mac": "electron-builder --mac --publish=never",
    "pack": "electron-builder --dir",
    "rebuild-mac": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "test:e2e": "node tests/e2e/pos.e2e.js",
    "test:all": "npm test && npm run test:e2e",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/main/**/*.js",
      "!src/main/main.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  },
  "keywords": [
    "pos",
    "cafe",
    "restaurant",
    "billing",
    "inventory",
    "sales",
    "coffee",
    "electron"
  ],
  "author": {
    "name": "Ayush Kaushik",
    "email": "coc123.1607@gmail.com",
    "url": "https://github.com/ayushkaushik"
  },
  "license": "MIT",
  "homepage": "https://github.com/ww2d2vjh8c-lab/POS-BASIC-BILLING",
  "repository": {
    "type": "git",
    "url": "https://github.com/ww2d2vjh8c-lab/POS-BASIC-BILLING.git"
  },
  "bugs": {
    "url": "https://github.com/ww2d2vjh8c-lab/POS-BASIC-BILLING/issues"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "jest": "^29.0.0",
    "playwright-core": "^1.48.2"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-is-dev": "^2.0.0"
  },
  "build": {
    "appId": "com.bloomcafe.pos",
    "productName": "Bloom Cafe POS",
    "copyright": "Copyright © 2026 Ayush Kaushik",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": null,
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "config/**/*",
      "package.json",
      "!**/node_modules/better-sqlite3/deps/**",
      "!**/node_modules/better-sqlite3/src/**",
      "!**/node_modules/better-sqlite3/binding.gyp",
      "!**/node_modules/better-sqlite3/build/deps/**",
      "!**/node_modules/better-sqlite3/build/Release/obj/**",
      "!**/node_modules/better-sqlite3/build/Release/test_extension.node"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Bloom Cafe POS"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Bloom Cafe POS",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "build/license.txt",
      "artifactName": "Bloom-Cafe-POS-Setup-${version}.${ext}"
    }
  }
}
